# Variables compartidas para docker-compose (copiar a .env en la raíz)
POSTGRES_DB=reforma
POSTGRES_USER=reforma
POSTGRES_PASSWORD=change_me_local
JWT_SECRET=dev_jwt_secret_minimo_64_caracteres_para_desarrollo_local_reforma_2026
JWT_ML_SECRET=dev_ml_jwt_secret_minimo_64_caracteres_compartido_domain_ml

# Email transaccional (verificacion, reset de password, invitaciones)
# EMAIL_MODE=log  -> escribe el enlace en el log (default, no envia correo)
# EMAIL_MODE=smtp -> envia correo real usando SMTP_*
# Para Gmail: host smtp.gmail.com, puerto 587 y un App Password de 16 caracteres (sin espacios)
EMAIL_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_sin_espacios
EMAIL_FROM=tu_correo@gmail.com
