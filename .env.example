# Variables compartidas para docker-compose (copiar a .env en la raíz)
POSTGRES_DB=reforma
POSTGRES_USER=reforma
POSTGRES_PASSWORD=change_me_local
JWT_SECRET=dev_jwt_secret_minimo_64_caracteres_para_desarrollo_local_reforma_2026
JWT_ML_SECRET=dev_ml_jwt_secret_minimo_64_caracteres_compartido_domain_ml

# Email transaccional (verificacion, reset de password, invitaciones)
# EMAIL_MODE=log  -> escribe el enlace en el log (default, no envia correo)
# EMAIL_MODE=smtp -> envia correo real usando SMTP_*
# Para Gmail: host smtp.gmail.com, puerto 587 y un App Password de 16 caracteres (sin espacios)
EMAIL_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_sin_espacios
EMAIL_FROM=tu_correo@gmail.com

# Suscripciones y pagos (Mercado Pago)
# PAGOS_MODE=simulado -> pasarela simulada (default, sin credenciales, para dev/demo)
# PAGOS_MODE=mp       -> Mercado Pago real: exige MP_ACCESS_TOKEN y MP_WEBHOOK_SECRET
# Credenciales: panel de desarrolladores de MP (mercadopago.com.ar/developers), aplicacion
# propia -> Access Token (usar el de PRUEBA "TEST-" en sandbox) y clave secreta de Webhooks.
# NUNCA commitear tokens reales NI de prueba: van solo en el .env (gitignored).
PAGOS_MODE=simulado
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL publica del frontend para back_url del checkout (en sandbox: tunel ngrok/cloudflared)
MP_BACK_URL_BASE=http://localhost:4200
# Precios de lista en ARS (opcional: defaults en application.yml)
#PRECIO_STARTER_MES=50750
#PRECIO_BUSINESS_MES=143550
#PRECIO_ENTERPRISE_MES=332050
