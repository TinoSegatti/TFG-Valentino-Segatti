# Imagen temporal SOLO para correr los tests unitarios en Linux (sin Maven local).
# Espeja el Dockerfile de prod hasta dependency:go-offline para reutilizar la capa cacheada.
FROM maven:3.9-eclipse-temurin-21-alpine AS build
WORKDIR /app
COPY pom.xml ./
RUN mvn -q -Dmaven.test.skip=true dependency:go-offline
COPY src ./src
RUN mvn test
